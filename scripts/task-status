#!/usr/bin/env bash
# Show what a task run is doing.
# Usage: task-status [unit-name]   (no argument = most recent)
#
# Reads the run's own OpenCode server when it is up, and falls back to the log.
set -euo pipefail

RUNS="${XDG_DATA_HOME:-$HOME/.local/share}/ecosym/runs"
UNIT="${1:-$(ls -t "$RUNS"/*.log 2>/dev/null | head -1 | xargs -r basename | sed 's/\.log$//')}"

[ -n "${UNIT:-}" ] || { echo "no runs found" >&2; exit 1; }

echo "unit: $UNIT"
systemctl --user is-active "$UNIT.service" 2>/dev/null || true

PORT_FILE="$RUNS/$UNIT.port"
if [ -f "$PORT_FILE" ]; then
  PORT="$(cat "$PORT_FILE")"
  TODO="$(curl -s --max-time 3 "http://127.0.0.1:$PORT/session/status" 2>/dev/null || true)"
  if [ -n "$TODO" ]; then
    echo "--- live (port $PORT) ---"
    echo "$TODO" | head -c 1200
    echo
  fi
fi

echo "--- log ---"
tail -40 "$RUNS/$UNIT.log" 2>/dev/null || echo "(no log yet)"

echo
echo "--- every run ---"
"$(dirname "$0")/run-ledger" list 2>/dev/null || true
