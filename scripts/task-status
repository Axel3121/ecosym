#!/usr/bin/env bash
# Show the status and log of a task run started by run-task.
# Usage: task-status [unit-name]   (no argument = most recent)
set -euo pipefail

RUNS="$HOME/.local/share/axey/runs"

if [ $# -ge 1 ]; then
  UNIT="$1"
else
  UNIT="$(ls -t "$RUNS"/*.log 2>/dev/null | head -1 | xargs -r basename | sed 's/\.log$//')"
fi

[ -n "${UNIT:-}" ] || { echo "no runs found" >&2; exit 1; }

echo "unit: $UNIT"
systemctl --user is-active "$UNIT.service" 2>/dev/null || true
if [ -f "$RUNS/$UNIT.port" ]; then
  echo "port: $(cat "$RUNS/$UNIT.port")  (talk to it: scripts/task-say \"...\")"
fi
echo "---"
tail -40 "$RUNS/$UNIT.log" 2>/dev/null || echo "(no log yet)"
