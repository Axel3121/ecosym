#!/usr/bin/env bash
# Would this be a second pull request for a subject one already owns?
#
# DEVELOPMENT.md: "A pull request is opened per subject, not per kind of
# change." Prose alone did not hold: four pull requests were opened in one
# evening for work that belonged in two. This answers the question the rule
# asks, before `gh pr create` is typed.
#
#   scripts/pr-overlap            # from a branch, against its open siblings
#
# Exit 1 when an open pull request already touches these files. That is not a
# refusal — it is the check the rule asks for, and extending that pull request
# is usually right.
set -euo pipefail

cd "$(dirname "$0")/.."
BASE="${1:-origin/main}"
BRANCH="$(git rev-parse --abbrev-ref HEAD)"

if ! DIFF="$(git diff --name-only "$BASE...HEAD" 2>&1)"; then
  echo "cannot read this branch's own diff against $BASE: $DIFF" >&2
  echo "this is unknown, not 'no changes'" >&2
  exit 2
fi
mapfile -t MINE <<< "$DIFF"
[ -n "${MINE[0]:-}" ] || { echo "no changes against $BASE"; exit 0; }

echo "branch $BRANCH touches ${#MINE[@]} file(s)"

# A broken or unauthenticated gh returns an empty list, which reads exactly
# like "nothing overlaps". That is the failure this check exists to catch, so
# it must not be the failure this check performs. Ask gh once, explicitly, and
# stop if it could not answer.
LIMIT=200
if ! OPEN="$(gh pr list --state open --limit "$LIMIT" --json number,headRefName --jq '.[] | "\(.number) \(.headRefName)"' 2>&1)"; then
  echo "cannot ask GitHub what is open: $OPEN" >&2
  echo "this is unknown, not 'no overlap'" >&2
  exit 2
fi
if [ "$(printf '%s\n' "$OPEN" | grep -c .)" -ge "$LIMIT" ]; then
  echo "more than $LIMIT open pull requests; this check cannot see them all" >&2
  exit 2
fi

FOUND=0
while read -r NUM HEAD; do
  [ -n "$NUM" ] || continue
  [ "$HEAD" = "$BRANCH" ] && continue
  if ! THEIRS_RAW="$(gh pr diff "$NUM" --name-only 2>&1)"; then
    echo "cannot read PR #$NUM's files: $THEIRS_RAW" >&2
    exit 2
  fi
  mapfile -t THEIRS <<< "$THEIRS_RAW"
  OVERLAP=()
  for f in "${MINE[@]}"; do
    for g in "${THEIRS[@]}"; do
      [ "$f" = "$g" ] && OVERLAP+=("$f")
    done
  done
  if [ "${#OVERLAP[@]}" -gt 0 ]; then
    FOUND=1
    echo
    echo "  PR #$NUM ($HEAD) already touches:"
    printf '    %s\n' "${OVERLAP[@]}"
  fi
done <<< "$OPEN"

if [ "$FOUND" = 1 ]; then
  echo
  echo "Same files, likely the same subject. Extend that pull request instead,"
  echo "or say in this one why the subject is genuinely different."
  exit 1
fi
echo "no overlap with open pull requests"
