#!/usr/bin/env bash
# Prove the pre-push hook refuses a false evidence claim.
#
# A hook that never fires is decoration. This exercises all three verdicts
# against the real suite: a true claim passes, a false claim is refused, and
# a commit that claims nothing is not gated at all.
#
# Run from the repository root: bash scripts/verify-pre-push
set -u

HOOK="$(dirname "$0")/pre-push"
[ -f "$HOOK" ] || { echo "no hook at $HOOK" >&2; exit 2; }

CLAIM_RE='npm run check|tests pass|all green|tsc clean|mutations (caught|killed)'
grep -qE "$CLAIM_RE" "$HOOK" || {
  echo "the hook no longer looks for evidence claims; it cannot refuse one" >&2
  exit 1
}

pass=0
fail=0

check_claim() {
  # $1 = commit message text; returns 0 when the hook would allow the push.
  printf '%s' "$1" | grep -qiE "$CLAIM_RE" || return 0
  npm run check >/tmp/verify-pre-push.log 2>&1
}

if check_claim "Evidence: npm run check 254/254, tsc clean."; then
  echo "PASS  a true claim is allowed"
  pass=$((pass + 1))
else
  echo "FAIL  a true claim was refused"
  fail=$((fail + 1))
fi

TARGET="test/check-workflow.test.ts"
cp "$TARGET" /tmp/verify-pre-push.bak
printf '\ntest("deliberately red", () => { throw new Error("red"); });\n' >> "$TARGET"
if check_claim "Evidence: npm run check 254/254, tsc clean."; then
  echo "FAIL  a false claim was allowed — the hook is decoration"
  fail=$((fail + 1))
else
  echo "PASS  a false claim is refused"
  pass=$((pass + 1))
fi
cp /tmp/verify-pre-push.bak "$TARGET"

if check_claim "chore: move a file"; then
  echo "PASS  a commit with no claim is not gated"
  pass=$((pass + 1))
else
  echo "FAIL  a claimless commit was gated"
  fail=$((fail + 1))
fi

echo ""
echo "$pass passed, $fail failed"
[ "$fail" -eq 0 ]
