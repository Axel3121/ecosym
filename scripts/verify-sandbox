#!/usr/bin/env bash
# Exercise the filesystem boundaries without involving a model.
set -uo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
SANDBOX="${ECOSYM_SANDBOX_COMMAND:-$ROOT/scripts/ecosym-sandbox}"
AGENT_SHELL="${ECOSYM_AGENT_SHELL_COMMAND:-$ROOT/scripts/agent-shell}"
PROBER_MODE="${ECOSYM_VERIFY_PROBER_MODE:-prober}"
SCOPE="${1:-all}"
PASS=0
FAIL=0

record() {
  local label="$1"
  local expected_status="$2"
  local expected_text="$3"
  local status="$4"
  local output="$5"
  if [ "$status" -eq "$expected_status" ] && [[ "$output" == *"$expected_text"* ]]; then
    printf 'PASS  %s\n' "$label"
    PASS=$((PASS + 1))
  else
    printf 'FAIL  %s (expected status=%s containing=%q; got status=%s)\n' \
      "$label" "$expected_status" "$expected_text" "$status"
    FAIL=$((FAIL + 1))
  fi
  if [ -n "$output" ]; then
    printf '%s\n' "$output" | sed 's/^/      /'
  fi
}

inside() {
  ECOSYM_SANDBOX_EXEC=/bin/bash "$SANDBOX" -c "$1"
}

check_inside() {
  local label="$1"
  local expected_status="$2"
  local expected_text="$3"
  local command="$4"
  local output
  output="$(inside "$command" 2>&1)"
  local status=$?
  record "$label" "$expected_status" "$expected_text" "$status" "$output"
}

verify_sources() {
  printf '%s\n' '=== declared source boundary ==='
  check_inside \
    "declared SQLite table is readable" 0 "async_delegations" \
    '/usr/bin/node --input-type=module -e '\''import { DatabaseSync } from "node:sqlite"; const db = new DatabaseSync(process.env.HOME + "/.hermes/state.db", { readOnly: true }); try { console.log(db.prepare("SELECT name FROM sqlite_schema WHERE type = ?").get("table").name); } finally { db.close(); }'\'''
  check_inside \
    "declared report is readable" 0 "declared report readable" \
    'test -r "$HOME/shorts-content/output/reports/uploads.jsonl" && echo "declared report readable"'
  check_inside \
    "undeclared Shorts file is absent" 1 "No such file or directory" \
    'cat "$HOME/shorts-content/AGENTS.md"'
  local channel_reports=("$HOME"/shorts-content/output/reports/channel_report_*.json)
  if [ -e "${channel_reports[0]}" ]; then
    check_inside \
      "non-matching report sibling is absent" 1 "No such file or directory" \
      "cat '${channel_reports[0]}'"
  fi
  local sqlite_scope
  sqlite_scope="$(inside '/usr/bin/node --input-type=module -e '\''import { DatabaseSync } from "node:sqlite"; const db = new DatabaseSync(process.env.HOME + "/.hermes/state.db", { readOnly: true }); try { console.log(db.prepare("SELECT name FROM sqlite_schema WHERE type = ? AND name = ?").get("table", "messages")?.name ?? "hidden"); } finally { db.close(); }'\''' 2>&1)"
  printf 'LIMIT SQLite is isolated at file level; undeclared table lookup returned: %s\n' "$sqlite_scope"
  check_inside \
    "declared report remains read-only" 1 "Read-only file system" \
    'printf changed > "$HOME/shorts-content/output/reports/uploads.jsonl"'
  check_inside \
    "undeclared Shorts paths remain read-only" 1 "Read-only file system" \
    'printf changed > "$HOME/shorts-content/not-declared.txt"'
  check_inside \
    "undeclared Hermes paths remain read-only" 1 "Read-only file system" \
    'printf changed > "$HOME/.hermes/not-declared.txt"'
  check_inside \
    "ordinary agent worktree remains writable" 0 "worktree write succeeded" \
    'probe="$ECOSYM_WORKTREE/.sandbox-write-probe"; printf probe > "$probe" && rm -f "$probe" && echo "worktree write succeeded"'
  check_inside \
    "DNS still resolves" 0 "dns works" \
    'getent hosts api.openai.com >/dev/null && echo "dns works"'
}

verify_source_guard() {
  printf '%s\n' '=== source reachability guard ==='
  local output
  local status
  if [ "${ECOSYM_VERIFY_SOURCE_MUTANT:-0}" = 1 ]; then
    output="$(/bin/bash -c 'if test -e "$HOME/shorts-content/AGENTS.md"; then echo "undeclared file visible"; exit 1; else echo "undeclared file hidden"; fi' 2>&1)"
    status=$?
  else
    output="$(inside 'if test -e "$HOME/shorts-content/AGENTS.md"; then echo "undeclared file visible"; exit 1; else echo "undeclared file hidden"; fi' 2>&1)"
    status=$?
  fi
  record "undeclared source reachability is denied" 0 "undeclared file hidden" "$status" "$output"
}

verify_prober() {
  printf '%s\n' '=== prober write boundary ==='
  local before
  before="$(sha256sum "$ROOT/PRODUCT.md")"
  local scratch="/tmp/ecosym-prober-verification-$$.txt"
  local write_error="/tmp/ecosym-prober-verification-error-$$.txt"
  local output
  output="$("$AGENT_SHELL" \
    --mode "$PROBER_MODE" \
    --worktree "$ROOT" \
    --workdir "$ROOT" \
    -- /bin/bash -c \
    'touch "$ECOSYM_WORKTREE/PRODUCT.md" 2>'"$write_error"'
     write_status=$?
     printf "write_status=%s\n" "$write_status"
     cat '"$write_error"'
     printf "scratch works\n" > '"$scratch"'
     printf "scratch_status=%s\n" "$?"
     cat '"$scratch"'' 2>&1)"
  local status=$?
  record \
    "tracked write is denied while scratch succeeds" \
    0 \
    "write_status=1" \
    "$status" \
    "$output"
  if [[ "$output" == *"Read-only file system"* && "$output" == *"scratch_status=0"* && "$output" == *"scratch works"* ]]; then
    printf 'PASS  prober reports the OS denial and successful scratch write\n'
    PASS=$((PASS + 1))
  else
    printf 'FAIL  prober did not report both enforced outcomes\n'
    FAIL=$((FAIL + 1))
  fi
  local after
  after="$(sha256sum "$ROOT/PRODUCT.md")"
  if [ "$before" = "$after" ]; then
    printf 'PASS  tracked file content is unchanged\n'
    PASS=$((PASS + 1))
  else
    printf 'FAIL  tracked file content changed\n'
    FAIL=$((FAIL + 1))
  fi
  rm -f "$scratch" "$write_error"
}

case "$SCOPE" in
  all)
    verify_sources
    verify_source_guard
    verify_prober
    ;;
  --source-only) verify_sources ;;
  --source-guard-only) verify_source_guard ;;
  --prober-only) verify_prober ;;
  *)
    printf 'usage: %s [--source-only|--source-guard-only|--prober-only]\n' "$0" >&2
    exit 64
    ;;
esac

printf '\n%d passed, %d failed\n' "$PASS" "$FAIL"
[ "$FAIL" -eq 0 ]
