#!/usr/bin/env bash
# Continue a task's OpenCode session with a follow-up message.
#
# Verified behaviour: `run --attach <server> -c` resumes the most recent
# session and its context. This is a follow-up channel, not live steering —
# a run that is still working will not see the message until it finishes.
# Use `-s <session-id>` to target a specific session (see: opencode session list).
set -euo pipefail

RUNS="$HOME/.local/share/axey/runs"
MODEL="${AXEY_MODEL:-openai/gpt-5.6-sol}"
SESSION=""

if [ "${1:-}" = "-s" ]; then
  SESSION="$2"; shift 2
fi

[ $# -ge 1 ] || { echo "usage: task-say [-s <session-id>] <message>" >&2; exit 1; }

PORTFILE="$(ls -t "$RUNS"/*.port 2>/dev/null | head -1 || true)"
ATTACH=()
if [ -n "$PORTFILE" ] && [ -f "$PORTFILE" ]; then
  ATTACH=(--attach "http://localhost:$(cat "$PORTFILE")")
fi

RESUME=(-c)
[ -n "$SESSION" ] && RESUME=(-s "$SESSION")

exec "$HOME/bin/axey-sandbox" run --model "$MODEL" "${ATTACH[@]}" "${RESUME[@]}" "$@"
