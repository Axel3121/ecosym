#!/usr/bin/env bash
# Stop a run that has stopped working.
#
# A run holds its unit open while it waits, so systemd sees "active" whether
# the run is thinking or hung. Wall-clock time cannot tell those apart either:
# real runs here have taken up to 142 minutes, and the hang that prompted this
# sat for 123 minutes having consumed zero CPU seconds since launch.
#
# Silence is what separates them. A working run writes — tool calls, model
# output, its own reasoning — so a log that has not grown in a long while
# belongs to a run that will not resume. This watches the log, not the clock.
#
# The run's work is already on disk and usually already committed, so stopping
# a dead unit loses nothing and frees the name, the port, and the worktree.
set -euo pipefail

UNIT="${1:?usage: run-watchdog <unit> <log> [idle-seconds]}"
LOG="${2:?usage: run-watchdog <unit> <log> [idle-seconds]}"
IDLE="${3:-900}"

while systemctl --user is-active --quiet "$UNIT"; do
  sleep 60
  [ -e "$LOG" ] || continue
  now=$(date +%s)
  touched=$(stat -c %Y "$LOG" 2>/dev/null || echo "$now")
  quiet=$(( now - touched ))
  if [ "$quiet" -ge "$IDLE" ]; then
    printf 'watchdog: %s wrote nothing for %ds; stopping it\n' "$UNIT" "$quiet" >> "$LOG"
    systemctl --user stop "$UNIT" || true
    exit 0
  fi
done
