#!/usr/bin/env bash
# Launch a task specification as a sandboxed OpenCode run.
#
#   run-task 001-observation-layer                  # isolated, branch task/001-observation-layer
#   run-task 004-fix --branch other                 # isolated, on an existing branch
#
# Every run gets its own checkout so concurrent runs cannot overwrite each
# other's files or test against half-finished work. The repository, its history
# and its branches stay shared; only the working tree is private.
#
# Model, subagents, permissions and canonical reading all come from
# opencode.json and .opencode/agent/ — not from here.
set -euo pipefail

TASK=""
BRANCH=""

while [ $# -gt 0 ]; do
  case "$1" in
    # Kept as a harmless spelling for callers written before worktrees became
    # mandatory. It no longer changes launch behaviour.
    --worktree) shift ;;
    --branch)   BRANCH="${2:?--branch needs a name}"; shift 2 ;;
    -*)         echo "unknown option: $1" >&2; exit 2 ;;
    *)          [ -z "$TASK" ] || { echo "one task at a time" >&2; exit 2; }
                TASK="$1"; shift ;;
  esac
done

[ -n "$TASK" ] || { echo "usage: run-task <task-name> [--branch <name>]" >&2; exit 2; }

# A task name selects a specification the agent will follow as instructions.
# Anything that escapes docs/tasks/ would let an unrelated file be treated as
# a contract, so the name is a plain identifier or nothing at all.
case "$TASK" in
  *[!A-Za-z0-9._-]* | *..* | .* | "")
    echo "task name must be a plain identifier: $TASK" >&2
    exit 2
    ;;
esac

cd "$(dirname "$0")/.."
REPO="$PWD"
# Specifications are our workflow, not the product, so they live outside the
# repository — see DEVELOPMENT.md, "Repository artifacts". ECOSYM_TASKS points
# at that directory; the in-tree path stays as a fallback so a checkout that
# still carries them keeps working.
TASKS_ROOT="${ECOSYM_TASKS:-${XDG_DATA_HOME:-$HOME/.local/share}/ecosym/tasks}"
SPEC="$TASKS_ROOT/${TASK}.md"
if [ ! -f "$SPEC" ] && [ -f "docs/tasks/${TASK}.md" ]; then
  SPEC="docs/tasks/${TASK}.md"
fi
[ -f "$SPEC" ] || { echo "no spec at $SPEC" >&2; exit 1; }

# Every linked worktree needs the main repository's Git directory to commit.
if [ -z "${ECOSYM_PROJECT:-}" ]; then
  COMMON_DIR="$(git -C "$REPO" rev-parse --path-format=absolute --git-common-dir)"
  export ECOSYM_PROJECT="$(dirname "$COMMON_DIR")"
fi

STATE="${XDG_DATA_HOME:-$HOME/.local/share}/ecosym"
RUNS="$STATE/runs"
mkdir -p "$RUNS" "$STATE/worktrees"

# Two launchers must not both inspect an empty territory and then start. The
# kernel releases this lock if a launcher dies, unlike a lock directory that
# can strand every later run after an interruption.
exec 9>"$STATE/schedule.lock"
flock -x 9

# Freeze both the instructions and their scheduling fields before asking the
# conflict question. Checking one read and launching another would leave a
# shared-spec edit between them as an unchecked territory change.
SPEC_SNAPSHOT="$(mktemp "$STATE/${TASK}.spec.XXXXXX")"
trap 'rm -f "$SPEC_SNAPSHOT"' EXIT
cp "$SPEC" "$SPEC_SNAPSHOT"
DECLARATION_JSON="$("$REPO/scripts/run-ledger" declaration "$SPEC_SNAPSHOT")"

BRANCH="${BRANCH:-task/${TASK}}"
WORKTREE="$STATE/worktrees/${TASK}"

if [ -d "$WORKTREE" ]; then
  if HELD_BRANCH="$(git -C "$WORKTREE" symbolic-ref --quiet --short HEAD 2>/dev/null)"; then
    if [ "$HELD_BRANCH" != "$BRANCH" ]; then
      echo "worktree $WORKTREE holds branch $HELD_BRANCH; requested branch $BRANCH" >&2
      exit 1
    fi
  elif HELD_COMMIT="$(git -C "$WORKTREE" rev-parse --short HEAD 2>/dev/null)"; then
    echo "worktree $WORKTREE is detached at $HELD_COMMIT; requested branch $BRANCH" >&2
    exit 1
  else
    echo "existing worktree path is not a Git worktree: $WORKTREE" >&2
    exit 1
  fi
  CANDIDATE_COMMIT="$(git -C "$WORKTREE" rev-parse HEAD)"
elif git show-ref --quiet --verify "refs/heads/${BRANCH}"; then
  CANDIDATE_COMMIT="$(git rev-parse "$BRANCH")"
else
  CANDIDATE_COMMIT="$(git rev-parse main)"
fi

# The second launcher in a race waits on the lock and asks after the first run
# is registered. Check before creating or writing a worktree, using the exact
# commit it would receive. This call is intentionally one line: the regression
# test removes it to prove the refusal comes from here.
"$REPO/scripts/run-ledger" can-start "$TASK" --declaration "$DECLARATION_JSON" --commit "$CANDIDATE_COMMIT"

if [ -d "$WORKTREE" ]; then
  if [ -n "$(git -C "$WORKTREE" status --porcelain --untracked-files=all)" ]; then
    echo "worktree $WORKTREE has changes from an earlier run; refusing to reuse it" >&2
    exit 1
  fi
  echo "reusing worktree: $WORKTREE"
elif git show-ref --quiet --verify "refs/heads/${BRANCH}"; then
  git worktree add "$WORKTREE" "$BRANCH" >&2
else
  git worktree add -b "$BRANCH" "$WORKTREE" main >&2
fi

ACTUAL_COMMIT="$(git -C "$WORKTREE" rev-parse HEAD)"
if [ "$ACTUAL_COMMIT" != "$CANDIDATE_COMMIT" ]; then
  echo "worktree $WORKTREE moved from checked commit $CANDIDATE_COMMIT to $ACTUAL_COMMIT" >&2
  exit 1
fi

# This copy is the declaration the run starts with. run-ledger snapshots its
# parsed needs and touches below, so edits made during the run cannot shrink the
# territory it holds and the shared branch is never consulted for a live run.
mkdir -p "$WORKTREE/docs/tasks"
cp "$SPEC_SNAPSHOT" "$WORKTREE/$SPEC"
rm -f "$SPEC_SNAPSHOT"
trap - EXIT
export ECOSYM_WORKTREE="$WORKTREE"

# Run under a transient user unit so the work survives a Hermes restart.
# The sandbox keeps --die-with-parent, but its parent is now systemd, not us.
UNIT="ecosym-task-${TASK}-$(date +%s)"
# Two launches inside one second would otherwise share a unit name, and the
# ledger would show one run where two exist. Testing for the log and creating
# it are two steps, so two launches can both find it missing; `mkdir` is one
# step that only one of them can win. The directory is never removed: it marks
# a unit name as spent, which stays true after the run ends, and the name
# carries the launch second so it is not reused later anyway.
#
# A collision (EEXIST) is the only failure this loop should retry: it means
# another launch already holds this second's name, and appending 'b' tries
# the next one. Any other failure — an unwritable $RUNS, a full disk, a name
# over the filesystem's length limit — is not a collision and will not
# resolve itself by appending more letters; retrying it is an infinite hang
# with no diagnostic. Give up and say why instead.
MKDIR_ERR="$(mktemp)"
ATTEMPTS=0
while ! mkdir "$RUNS/${UNIT}.lock" 2>"$MKDIR_ERR"; do
  if ! grep -qi 'file exists' "$MKDIR_ERR"; then
    cat "$MKDIR_ERR" >&2
    rm -f "$MKDIR_ERR"
    echo "cannot reserve a unit name under $RUNS" >&2
    exit 1
  fi
  UNIT="${UNIT}b"
  ATTEMPTS=$((ATTEMPTS + 1))
  if [ "$ATTEMPTS" -ge 1000 ]; then
    rm -f "$MKDIR_ERR"
    echo "cannot reserve a unit name: 1000 collisions in a row for $UNIT" >&2
    exit 1
  fi
done
rm -f "$MKDIR_ERR"
LOG="$RUNS/${UNIT}.log"
if [ -n "${ECOSYM_PORT:-}" ]; then
  PORT="$ECOSYM_PORT"
else
  PORT="$(python3 -c "import socket;s=socket.socket();s.bind(('127.0.0.1',0));print(s.getsockname()[1]);s.close()")"
fi

# The JSON is kept in this process and in a fallback marker outside the
# worktree, so an agent that edits its own specification cannot change the
# territory later registered for it.
printf '%s\n' "$DECLARATION_JSON" > "$RUNS/${UNIT}.declaration.json"

echo "$PORT" > "$RUNS/${UNIT}.port"

echo "unit: $UNIT"
echo "log:  $LOG"
echo "port: $PORT"
echo "tree: $WORKTREE (branch $BRANCH)"

# A run that stops working holds its unit open, so nothing notices. Watch the
# log rather than the clock: silence is what tells a hung run from a slow one.
#
# Started AFTER the run's own unit, not before: run-watchdog's loop condition
# is `while systemctl --user is-active --quiet "$UNIT"`, so if the watchdog
# starts before $UNIT exists, is-active reports it inactive/not-found on the
# very first check, the loop body never runs, and the watchdog exits having
# monitored nothing. `systemd-run` below registers the transient unit and
# returns immediately — it does not wait for the run to finish, the same way
# this script goes on to record the ledger entry right after — so by the time
# the watchdog's systemd-run call is made, $UNIT is already active and a
# launch that writes nothing at all is still covered.
systemd-run --user --unit="$UNIT" --collect \
  --working-directory="$WORKTREE" \
  ${ECOSYM_PROJECT:+--setenv=ECOSYM_PROJECT="$ECOSYM_PROJECT"} \
  ${ECOSYM_WORKTREE:+--setenv=ECOSYM_WORKTREE="$ECOSYM_WORKTREE"} \
  --property=StandardOutput="append:$LOG" \
  --property=StandardError="append:$LOG" \
  "$REPO/scripts/ecosym-sandbox" run --variant max --port "$PORT" \
  "Follow the instructions in the attached files." \
  -f "$SPEC" -f scripts/run-instruction.md

# The run is now the ledger's business. A launch that is not recorded is a run
# nobody will account for later. It also has no territory other launchers can
# inspect, so allowing it to continue would break the collision guarantee.
if ! "$REPO/scripts/run-ledger" start "$TASK" "$UNIT" \
  --branch "$BRANCH" \
  --worktree "$WORKTREE" \
  --spec "$WORKTREE/$SPEC" \
  --declaration "$DECLARATION_JSON" \
  --commit "$(git -C "$WORKTREE" rev-parse HEAD 2>/dev/null || true)"; then
  systemctl --user stop "$UNIT.service" >/dev/null 2>&1 || true
  STOP_STATE="$(systemctl --user is-active "$UNIT.service" 2>/dev/null || true)"
  case "$STOP_STATE" in
    inactive|failed|unknown|not-found)
      echo "run stopped because the ledger did not record its territory: $UNIT" >&2
      ;;
    *)
      echo "run remains active without a ledger record: $UNIT (state: ${STOP_STATE:-unavailable})" >&2
      ;;
  esac
  exit 1
fi

# The registration above makes the territory visible before another launcher
# can acquire the lock and check it.
flock -u 9

systemd-run --user --unit="${UNIT}-watchdog" --collect \
  "$REPO/scripts/run-watchdog" "$UNIT" "$LOG" "${ECOSYM_IDLE_SECONDS:-900}" \
  >/dev/null 2>&1 || echo "warning: no watchdog for $UNIT" >&2

echo
echo "close it out when it is done:"
echo "  scripts/run-ledger close $UNIT --outcome landed --evidence '<commit or PR>'"
