#!/usr/bin/env bash
# Launch a task specification as a sandboxed OpenCode run.
#
#   run-task 001-observation-layer                  # in the main checkout
#   run-task 004-fix --worktree                     # isolated, branch task/004-fix
#   run-task 004-fix --worktree --branch other      # isolated, on an existing branch
#
# --worktree gives the run its own checkout so concurrent runs cannot overwrite
# each other's files or test against half-finished work. The repository, its
# history and its branches stay shared; only the working tree is private.
#
# Model, subagents, permissions and canonical reading all come from
# opencode.json and .opencode/agent/ — not from here.
set -euo pipefail

TASK=""
USE_WORKTREE=0
BRANCH=""

while [ $# -gt 0 ]; do
  case "$1" in
    --worktree) USE_WORKTREE=1; shift ;;
    --branch)   BRANCH="${2:?--branch needs a name}"; USE_WORKTREE=1; shift 2 ;;
    -*)         echo "unknown option: $1" >&2; exit 2 ;;
    *)          [ -z "$TASK" ] || { echo "one task at a time" >&2; exit 2; }
                TASK="$1"; shift ;;
  esac
done

[ -n "$TASK" ] || { echo "usage: run-task <task-name> [--worktree] [--branch <name>]" >&2; exit 2; }

cd "$(dirname "$0")/.."
REPO="$PWD"
SPEC="docs/tasks/${TASK}.md"
[ -f "$SPEC" ] || { echo "no spec at $SPEC" >&2; exit 1; }

RUNS="${XDG_DATA_HOME:-$HOME/.local/share}/ecosym/runs"
mkdir -p "$RUNS"

WORKTREE=""
if [ "$USE_WORKTREE" = 1 ]; then
  BRANCH="${BRANCH:-task/${TASK}}"
  WORKTREE="${XDG_DATA_HOME:-$HOME/.local/share}/ecosym/worktrees/${TASK}"

  if [ -d "$WORKTREE" ]; then
    echo "reusing worktree: $WORKTREE"
  elif git show-ref --quiet --verify "refs/heads/${BRANCH}"; then
    git worktree add "$WORKTREE" "$BRANCH" >&2
  else
    git worktree add -b "$BRANCH" "$WORKTREE" >&2
  fi

  # The spec may be untracked in the main checkout; the run needs it either way.
  mkdir -p "$WORKTREE/docs/tasks"
  cp "$SPEC" "$WORKTREE/$SPEC"
  export ECOSYM_WORKTREE="$WORKTREE"
fi

# Run under a transient user unit so the work survives a Hermes restart.
# The sandbox keeps --die-with-parent, but its parent is now systemd, not us.
UNIT="ecosym-task-${TASK}-$(date +%s)"
LOG="$RUNS/${UNIT}.log"
PORT="${ECOSYM_PORT:-$(python3 -c "import socket;s=socket.socket();s.bind(('127.0.0.1',0));print(s.getsockname()[1]);s.close()")}"

echo "$PORT" > "$RUNS/${UNIT}.port"

echo "unit: $UNIT"
echo "log:  $LOG"
echo "port: $PORT"
[ -n "$WORKTREE" ] && echo "tree: $WORKTREE (branch $BRANCH)"

systemd-run --user --unit="$UNIT" --collect \
  --working-directory="${WORKTREE:-$REPO}" \
  ${ECOSYM_WORKTREE:+--setenv=ECOSYM_WORKTREE="$ECOSYM_WORKTREE"} \
  --property=StandardOutput="append:$LOG" \
  --property=StandardError="append:$LOG" \
  "$HOME/bin/ecosym-sandbox" run --variant max --port "$PORT" \
  "Follow the instructions in the attached files." \
  -f "$SPEC" -f scripts/run-instruction.md
