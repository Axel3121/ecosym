{
  "$schema": "https://opencode.ai/config.json",

  "model": "openai/gpt-5.6-sol",
  "small_model": "openai/gpt-5.6-luna",

  "instructions": [
    "PRODUCT.md",
    "ARCHITECTURE.md",
    "SECURITY.md",
    "DEVELOPMENT.md"
  ],

  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*auth.json": "deny",
      "*credentials*": "deny",
      "*.pem": "deny",
      "*id_rsa*": "deny",
      "*id_ed25519*": "deny",
      "/home/axellie/.local/share/opencode/**": "deny",
      "/home/axellie/.local/state/opencode/**": "deny"
    },

    "edit": {
      "*": "allow",
      "/home/axellie/.hermes/**": "deny",
      "/home/axellie/shorts-content/**": "deny",
      "/home/axellie/.local/share/opencode/**": "deny",
      "/home/axellie/.local/state/opencode/**": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      ".opencode/**": "deny",
      "opencode.json": "deny",
      "src/agent-shell.ts": "deny",
      "src/sandbox.ts": "deny",
      "src/sandbox-cli.ts": "deny",
      "src/sandbox-runtime.ts": "deny"
    },

    "bash": {
      "*": "allow",
      "rm -rf /*": "deny",
      "rm -rf ~*": "deny",
      "sudo *": "deny",
      "npm publish*": "deny",
      "git push*": "deny"
    },

    "external_directory": {
      "*": "allow"
    },

    "webfetch": "allow",
    "websearch": "allow"
  }
}
