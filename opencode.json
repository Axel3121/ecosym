{
  "$schema": "https://opencode.ai/config.json",

  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*auth.json": "deny",
      "*credentials*": "deny",
      "*.pem": "deny",
      "*id_rsa*": "deny",
      "*id_ed25519*": "deny"
    },

    "edit": {
      "*": "allow",
      "/home/axellie/.hermes/**": "deny",
      "/home/axellie/shorts-content/**": "deny",
      "*.env": "deny",
      "*.env.*": "deny"
    },

    "bash": {
      "*": "allow",
      "rm -rf /*": "deny",
      "rm -rf ~*": "deny",
      "sudo *": "deny",
      "npm publish*": "deny",
      "curl*|*sh": "deny",
      "wget*|*sh": "deny"
    },

    "external_directory": {
      "*": "allow"
    },

    "webfetch": "allow",
    "websearch": "allow",
    "doom_loop": "allow"
  }
}
